<?xml version="1.0" encoding="utf-8"?>
<Project>

  <!--
    Deploy the runtime data that GDAL and PROJ need.

    vcpkg installs these under share/, and nothing copies them next to the
    binaries. GdalEnvironment looks for "gdal-data" and "proj" beside the
    loaded module, so they are copied there.
  -->

  <PropertyGroup>
    <MwgDeployRuntimeData Condition="'$(MwgDeployRuntimeData)' == ''">true</MwgDeployRuntimeData>
  </PropertyGroup>

  <Target Name="MwgDeployGdalRuntimeData"
          AfterTargets="Build"
          Condition="'$(MwgDeployRuntimeData)' == 'true' And '$(ConfigurationType)' != 'StaticLibrary'">

    <ItemGroup>
      <MwgGdalData Include="$(MwgVcpkgTripletDir)share\gdal\**\*" />
      <MwgProjData Include="$(MwgVcpkgTripletDir)share\proj\**\*" />
    </ItemGroup>

    <Copy SourceFiles="@(MwgGdalData)"
          DestinationFiles="@(MwgGdalData->'$(OutDir)gdal-data\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(MwgGdalData)' != ''" />

    <Copy SourceFiles="@(MwgProjData)"
          DestinationFiles="@(MwgProjData->'$(OutDir)proj\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(MwgProjData)' != ''" />

    <Warning Text="GDAL runtime data was not found in $(MwgVcpkgTripletDir)share\gdal. Run build\scripts\bootstrap-vcpkg.ps1 and rebuild."
             Condition="'@(MwgGdalData)' == ''" />
  </Target>

  <Import Project="$(MwgVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets"
          Condition="Exists('$(MwgVcpkgRoot)\scripts\buildsystems\msbuild\vcpkg.targets')" />

  <!--
    vcpkg's incremental install check only compares vcpkg.json and
    vcpkg-configuration.json with its stamp file, so changing MwgVcpkgFeatures
    (for example adding full-drivers) silently reused the previous install.
    The install tree and stamp are shared by all configurations of a platform,
    so the feature set actually installed is recorded next to the stamp after
    each successful install. When the requested features differ from that
    record, the stamp is deleted to force vcpkg to reinstall the tree.
  -->
  <PropertyGroup>
    <_MwgVcpkgTrackFeatures Condition="'$(VcpkgEnabled)' == 'true' And '$(VcpkgEnableManifest)' == 'true' And '$(VcpkgManifestInstall)' == 'true'">true</_MwgVcpkgTrackFeatures>
    <_MwgVcpkgInstalledFeaturesFile>$(_ZVcpkgMSBuildStampFile).features.txt</_MwgVcpkgInstalledFeaturesFile>
  </PropertyGroup>

  <Target Name="MwgInvalidateVcpkgInstallOnFeatureChange"
          BeforeTargets="VcpkgInstallManifestDependencies"
          Condition="'$(_MwgVcpkgTrackFeatures)' == 'true'">
    <ReadLinesFromFile File="$(_MwgVcpkgInstalledFeaturesFile)"
                       Condition="Exists('$(_MwgVcpkgInstalledFeaturesFile)')">
      <Output TaskParameter="Lines" ItemName="_MwgVcpkgInstalledFeatures" />
    </ReadLinesFromFile>

    <Delete Files="$(_ZVcpkgMSBuildStampFile)"
            Condition="!Exists('$(_MwgVcpkgInstalledFeaturesFile)') Or '@(_MwgVcpkgInstalledFeatures)' != '$(MwgVcpkgFeatures)'" />
  </Target>

  <Target Name="MwgRecordVcpkgInstalledFeatures"
          AfterTargets="VcpkgInstallManifestDependencies"
          Condition="'$(_MwgVcpkgTrackFeatures)' == 'true'">
    <PropertyGroup>
      <_MwgVcpkgProjectFeaturesFile>$([MSBuild]::NormalizePath('$(ProjectDir)', '$(IntDir)', 'vcpkg-features-$(VcpkgTriplet).txt'))</_MwgVcpkgProjectFeaturesFile>
    </PropertyGroup>

    <ReadLinesFromFile File="$(_MwgVcpkgInstalledFeaturesFile)"
                       Condition="Exists('$(_MwgVcpkgInstalledFeaturesFile)')">
      <Output TaskParameter="Lines" ItemName="_MwgVcpkgRecordedFeatures" />
    </ReadLinesFromFile>

    <!-- Parallel projects may publish the same record; stage it per project
         and copy with retries instead of writing the shared file directly. -->
    <WriteLinesToFile File="$(_MwgVcpkgProjectFeaturesFile)"
                      Lines="$(MwgVcpkgFeatures)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <Copy SourceFiles="$(_MwgVcpkgProjectFeaturesFile)"
          DestinationFiles="$(_MwgVcpkgInstalledFeaturesFile)"
          Retries="10"
          RetryDelayMilliseconds="200"
          Condition="!Exists('$(_MwgVcpkgInstalledFeaturesFile)') Or '@(_MwgVcpkgRecordedFeatures)' != '$(MwgVcpkgFeatures)'" />
  </Target>

</Project>
