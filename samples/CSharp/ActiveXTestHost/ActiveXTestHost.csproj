<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <MwgDeployRuntimeData>false</MwgDeployRuntimeData>
    <Platforms>Win32;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'Win32'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' == 'x64'">x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(Platform)' == 'Win32'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\..\..\bin\$(Configuration)\$(Platform)\</OutputPath>
    <DefineConstants Condition="'$(Platform)' == 'Win32'">$(DefineConstants);MWG_X86</DefineConstants>
    <DefineConstants Condition="'$(Platform)' == 'x64'">$(DefineConstants);MWG_X64</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\MapWinGIS.ActiveX\MapWinGIS.ActiveX.vcxproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest" />
  </ItemGroup>

</Project>
