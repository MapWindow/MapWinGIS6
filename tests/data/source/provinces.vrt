<OGRVRTDataSource>
  <!-- Source of truth for the generated test data; see tests/data/README.md. -->
  <OGRVRTLayer name="provinces">
    <SrcDataSource relativeToVRT="1">provinces.csv</SrcDataSource>
    <SrcLayer>provinces</SrcLayer>
    <OpenOptions>
      <OOI key="EMPTY_STRING_AS_NULL">YES</OOI>
    </OpenOptions>
    <GeometryType>wkbPolygon</GeometryType>
    <LayerSRS>EPSG:28992</LayerSRS>
    <GeometryField encoding="WKT" field="WKT" />
    <Field name="ID" type="Integer" src="ID" />
    <Field name="NAME" type="String" width="32" src="NAME" />
    <Field name="AREA_KM2" type="Real" width="18" precision="4" src="AREA_KM2" />
    <Field name="SURVEYED" type="Date" src="SURVEYED" />
    <Field name="ACTIVE" type="Integer" subtype="Boolean" src="ACTIVE" />
  </OGRVRTLayer>
</OGRVRTDataSource>
