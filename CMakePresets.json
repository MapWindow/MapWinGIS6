{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "Shared settings. The vcpkg toolchain is resolved by CMakeLists.txt (MWG_VCPKG_ROOT, ../vcpkg, VCPKG_ROOT).",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_HOST_TRIPLET": "x64-windows-v145",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "x64",
      "hidden": true,
      "description": "x64. 'architecture' only informs Visual Studio; in CLion assign a Visual Studio toolchain with architecture amd64.",
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-v145",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/cmake-x64"
      }
    },
    {
      "name": "x86",
      "hidden": true,
      "description": "Win32. 'architecture' only informs Visual Studio; in CLion assign a Visual Studio toolchain with architecture x86 or amd64_x86.",
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x86-windows-v145",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed/cmake-Win32"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ninja",
      "hidden": true,
      "description": "Single-config Ninja. Toolset and Windows SDK come from the vcvars environment (CLion toolchain, VS Developer PowerShell).",
      "generator": "Ninja"
    },
    {
      "name": "vs2026",
      "hidden": true,
      "description": "Multi-config Visual Studio generator; pins toolset v145 and the Windows SDK (MWG_WINDOWS_SDK).",
      "generator": "Visual Studio 18 2026",
      "toolset": { "value": "v145", "strategy": "set" }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug (Ninja)",
      "inherits": [ "windows-base", "ninja", "x64", "debug" ],
      "binaryDir": "${sourceDir}/out/b/x64d"
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release (Ninja)",
      "inherits": [ "windows-base", "ninja", "x64", "release" ],
      "binaryDir": "${sourceDir}/out/b/x64r"
    },
    {
      "name": "x86-debug",
      "displayName": "Win32 Debug (Ninja)",
      "inherits": [ "windows-base", "ninja", "x86", "debug" ],
      "binaryDir": "${sourceDir}/out/b/x86d"
    },
    {
      "name": "x86-release",
      "displayName": "Win32 Release (Ninja)",
      "inherits": [ "windows-base", "ninja", "x86", "release" ],
      "binaryDir": "${sourceDir}/out/b/x86r"
    },
    {
      "name": "vs2026-x64",
      "displayName": "x64 (Visual Studio 18 2026)",
      "inherits": [ "windows-base", "vs2026", "x64" ],
      "architecture": { "value": "x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/out/b/vs-x64"
    },
    {
      "name": "vs2026-x86",
      "displayName": "Win32 (Visual Studio 18 2026)",
      "inherits": [ "windows-base", "vs2026", "x86" ],
      "architecture": { "value": "Win32", "strategy": "set" },
      "binaryDir": "${sourceDir}/out/b/vs-x86"
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug" },
    { "name": "x64-release", "configurePreset": "x64-release" },
    { "name": "x86-debug", "configurePreset": "x86-debug" },
    { "name": "x86-release", "configurePreset": "x86-release" },
    { "name": "vs2026-x64-debug", "configurePreset": "vs2026-x64", "configuration": "Debug" },
    { "name": "vs2026-x64-release", "configurePreset": "vs2026-x64", "configuration": "Release" },
    { "name": "vs2026-x86-debug", "configurePreset": "vs2026-x86", "configuration": "Debug" },
    { "name": "vs2026-x86-release", "configurePreset": "vs2026-x86", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "interactive" } }
    },
    { "name": "x64-debug", "inherits": "test-base", "configurePreset": "x64-debug" },
    { "name": "x64-release", "inherits": "test-base", "configurePreset": "x64-release" },
    { "name": "x86-debug", "inherits": "test-base", "configurePreset": "x86-debug" },
    { "name": "x86-release", "inherits": "test-base", "configurePreset": "x86-release" },
    { "name": "vs2026-x64-debug", "inherits": "test-base", "configurePreset": "vs2026-x64", "configuration": "Debug" },
    { "name": "vs2026-x64-release", "inherits": "test-base", "configurePreset": "vs2026-x64", "configuration": "Release" },
    { "name": "vs2026-x86-debug", "inherits": "test-base", "configurePreset": "vs2026-x86", "configuration": "Debug" },
    { "name": "vs2026-x86-release", "inherits": "test-base", "configurePreset": "vs2026-x86", "configuration": "Release" }
  ]
}
