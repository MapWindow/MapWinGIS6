import "oaidl.idl";
import "ocidl.idl";

[
    uuid(E3E35346-7259-41AB-B419-D87D0BEE867E),
    version(1.0)
]
library MapWinGISActiveXLib
{
    importlib("stdole2.tlb");

    [
        object,
        dual,
        oleautomation,
        uuid(1B6D4167-B2D7-4AE4-8F88-92C575BF4AF7),
        pointer_default(unique)
    ]
    interface IMapWinGISControl : IDispatch
    {
        [propget, id(1)]
        HRESULT CoreInitialized([out, retval] VARIANT_BOOL* initialized);

        [id(2)]
        HRESULT LoadVectorDataset([in] BSTR path);

        [propget, id(3)]
        HRESULT LayerLoaded([out, retval] VARIANT_BOOL* loaded);

        [propget, id(4)]
        HRESULT FeatureCount([out, retval] hyper* count);
    };

    // Published interfaces are immutable; new members go on a derived
    // interface with its own IID so clients never call missing vtable slots.
    [
        object,
        dual,
        oleautomation,
        uuid(2C386A29-C378-45C1-B8D5-5624500CCFF2),
        pointer_default(unique)
    ]
    interface IMapWinGISControl2 : IMapWinGISControl
    {
        [propget, id(5)]
        HRESULT RenderingBackend([out, retval] BSTR* backend);

        [propget, id(6)]
        HRESULT RenderingStatus([out, retval] BSTR* status);

        [propget, id(7)]
        HRESULT RenderingBackendPreference([out, retval] BSTR* preference);

        [propput, id(7)]
        HRESULT RenderingBackendPreference([in] BSTR preference);
    };

    [
        object,
        dual,
        oleautomation,
        uuid(994F4526-284B-463F-8ED5-1551B601981B),
        pointer_default(unique)
    ]
    interface IMapWinGISControl3 : IMapWinGISControl2
    {
        [id(8)]
        HRESULT ClearLayers();
    };

    [
        object,
        dual,
        oleautomation,
        uuid(EA0484AC-2A78-462C-AAE1-B0D6F11E4D7A),
        pointer_default(unique)
    ]
    interface IMapWinGISControl4 : IMapWinGISControl3
    {
        [propget, id(9)]
        HRESULT LayerCount([out, retval] LONG* count);

        [id(10)]
        HRESULT GetLayerId([in] LONG index, [out, retval] hyper* layerId);

        [id(11)]
        HRESULT ZoomToMap([out, retval] VARIANT_BOOL* changed);

        [id(12)]
        HRESULT ZoomToLayer([in] hyper layerId, [out, retval] VARIANT_BOOL* changed);

        [id(13)]
        HRESULT ZoomIn([out, retval] VARIANT_BOOL* changed);

        [id(14)]
        HRESULT ZoomOut([out, retval] VARIANT_BOOL* changed);

        [id(15)]
        HRESULT RemoveLayer([in] hyper layerId, [out, retval] VARIANT_BOOL* changed);

        [id(16)]
        HRESULT SetLayerVisible(
            [in] hyper layerId,
            [in] VARIANT_BOOL visible,
            [out, retval] VARIANT_BOOL* changed);
    };

    [
        object,
        dual,
        oleautomation,
        uuid(51A7F506-5FAB-45F3-A56B-1BE72738721B),
        pointer_default(unique)
    ]
    interface IMapWinGISControl5 : IMapWinGISControl4
    {
        [id(17)]
        HRESULT LoadRasterDataset([in] BSTR path);
    };

    [
        object,
        dual,
        oleautomation,
        uuid(C4A9D339-5B0A-44B3-A700-5C4E4C31E2D6),
        pointer_default(unique)
    ]
    interface IMapWinGISControl6 : IMapWinGISControl5
    {
        // Pan by map-coordinate units; zoom anchors use viewport pixels.
        [id(18)]
        HRESULT Pan(
            [in] double deltaX,
            [in] double deltaY,
            [out, retval] VARIANT_BOOL* changed);

        [id(19)]
        HRESULT ZoomAt(
            [in] double screenX,
            [in] double screenY,
            [in] double factor,
            [out, retval] VARIANT_BOOL* changed);

        [id(20)]
        HRESULT ZoomInBy([in] double factor, [out, retval] VARIANT_BOOL* changed);

        [id(21)]
        HRESULT ZoomOutBy([in] double factor, [out, retval] VARIANT_BOOL* changed);

        // History keeps at most 100 prior views.
        [propget, id(22)]
        HRESULT CanGoBack([out, retval] VARIANT_BOOL* canGoBack);

        [propget, id(23)]
        HRESULT CanGoForward([out, retval] VARIANT_BOOL* canGoForward);

        [id(24)]
        HRESULT GoBack([out, retval] VARIANT_BOOL* changed);

        [id(25)]
        HRESULT GoForward([out, retval] VARIANT_BOOL* changed);

        // Animations run on the control's owner-thread timer.
        [id(26)]
        HRESULT AnimateZoomToMap([in] LONG durationMilliseconds);

        [id(27)]
        HRESULT AnimateZoomToLayer(
            [in] hyper layerId,
            [in] LONG durationMilliseconds);

        [propget, id(28)]
        HRESULT IsAnimating([out, retval] VARIANT_BOOL* isAnimating);

        [id(29)]
        HRESULT StopAnimation();
    };

    [
        object,
        dual,
        oleautomation,
        uuid(7D989B8F-2B70-4A5E-9AA4-81D0A16BF651),
        pointer_default(unique)
    ]
    interface IMapWinGISControl7 : IMapWinGISControl6
    {
        [id(30)]
        HRESULT MoveLayer(
            [in] hyper layerId,
            [in] LONG newPosition,
            [out, retval] VARIANT_BOOL* changed);

        [id(31)]
        HRESULT LoadXyzTileLayer(
            [in] BSTR urlTemplate,
            [in] LONG minimumZoom,
            [in] LONG maximumZoom);
    };

    [
        object,
        dual,
        oleautomation,
        uuid(65E33073-669C-43E3-9A96-EF8D38F5EDAC),
        pointer_default(unique)
    ]
    interface IMapWinGISControlGdal : IDispatch
    {
        [id(1)]
        HRESULT BeginGdalOperation(
            [in] BSTR algorithmPath,
            [in] SAFEARRAY(BSTR) arguments,
            [out, retval] hyper* operationId);

        [id(2)]
        HRESULT CancelGdalOperation([in] hyper operationId);

        [id(3)]
        HRESULT EndGdalOperation(
            [in] hyper operationId,
            [out] VARIANT_BOOL* succeeded,
            [out] VARIANT_BOOL* cancelled,
            [out] LONG* errorCode,
            [out] LONG* callbackErrorCode,
            [out] BSTR* callbackError,
            [out] BSTR* summary,
            [out] BSTR* diagnostics,
            [out] SAFEARRAY(BSTR)* warnings);
    };

    [
        uuid(3EC7E255-3045-4A32-A9DA-12FA310FD3F0)
    ]
    dispinterface IMapWinGISControlEvents
    {
        properties:
        methods:
            [id(1)]
            void GdalProgress(
                [in] hyper operationId,
                [in] double progress,
                [in] BSTR message);

            [id(2)]
            void GdalOperationCompleted([in] hyper operationId);
    };

    [
        uuid(2F0AB6FC-F7C0-4E42-A002-A61F9C6F294F),
        control
    ]
    coclass MapWinGISControl
    {
        [default] interface IMapWinGISControl7;
        interface IMapWinGISControl6;
        interface IMapWinGISControl5;
        interface IMapWinGISControl4;
        interface IMapWinGISControl3;
        interface IMapWinGISControl2;
        interface IMapWinGISControl;
        interface IMapWinGISControlGdal;
        [default, source] dispinterface IMapWinGISControlEvents;
    };
};
